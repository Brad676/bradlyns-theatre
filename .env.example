# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign JWT auth tokens (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# ── Server ────────────────────────────────────────────────────────────────────

# Port the API server listens on (Render/Heroku set this automatically)
PORT=8080

# Set to "production" when deploying
NODE_ENV=production

# ── Frontend (only needed when deploying frontend separately on Vercel) ────────

# Full URL of your deployed API server — leave blank when running full-stack
# VITE_API_BASE_URL=https://bradlyns-theatre.onrender.com

# Vite base path — always "/" for standard deployments
BASE_PATH=/
