{
  "version": 2,
  "installCommand": "npm install -g pnpm && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:api && pnpm run build:frontend",
  "outputDirectory": "artifacts/bradlyn-theatre/dist/public",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "artifacts/api-server/dist/vercel/**,node_modules/pino/**,node_modules/pino-http/**,node_modules/thread-stream/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "BASE_PATH": "/",
    "PORT": "3000",
    "NODE_ENV": "production"
  }
}
